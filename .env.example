# Chat Service Configuration

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Alternative LLM Providers (compatible with OpenAI API)
# Example for Ollama: OPENAI_BASE_URL=http://localhost:11434/v1
# Example for vLLM: OPENAI_BASE_URL=http://localhost:8000/v1

# Generation Parameters
TEMPERATURE=0.7
MAX_TOKENS=4096
TOP_P=1.0

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Knowledge Base Configuration
CHROMA_PERSIST_DIR=./data/chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Text2SQL Configuration
SQL_METADATA_PATH=./data/metadata.sql

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
