# App Settings
APP_NAME=LangGraph Agent
APP_VERSION=0.2.0
DEBUG=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
# API_KEY=your-secret-key-here

# LLM Settings
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# BASE_URL=https://api.openai.com/v1  # For self-hosted models

# Embedding Settings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Redis (Memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Database (for NL2SQL Agent)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=demo
DB_USER=demo
# DB_PASSWORD=your-db-password

# Web Search (choose one)
# TAVILY_API_KEY=your-tavily-key
# BRAVE_API_KEY=your-brave-key

# Intent Router
INTENT_CONFIDENCE_THRESHOLD=0.6
ENABLE_FALLBACK_TO_GENERAL=true
